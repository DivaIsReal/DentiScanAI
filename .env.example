# =====================================================
# DentiScan — Environment Variables Example
# Copy this file to .env.local and adjust the values
# =====================================================

# ---- AUTHENTICATION ----
# Secret used to sign JWTs. MUST be changed in production.
# Use a long random string (min 32 chars).
JWT_SECRET=d1F2g3H4j5K6l7M8n9P0qR1sT2uV3wX4yZ5aB6cD7eF8gH9jK0

# ---- DATABASE ----
# MongoDB connection string. Leave empty to use the
# in-memory dummy store (great for quick local demos).
# Local:   mongodb://localhost:27017/dentiscan
# Atlas:   mongodb+srv://<user>:<pass>@cluster.mongodb.net/dentiscan
MONGODB_URI=mongodb+srv://dentiscan_user:1lWv5TqQD6ZT1w7D@dentitscan.eld4yko.mongodb.net/?appName=DentiScan

# ---- AI INTEGRATION (optional — dummy is used by default) ----
# Future FastAPI endpoint exposing the trained Computer Vision model
# (managed by the AI Engineer team). When set, predict.ts will POST
# the uploaded image here instead of returning dummy predictions.
AI_API_URL=https://your-fastapi-url.railway.app

# Gemini API key for the DentiBot chatbot (Agentic AI).
# When set, generateChatResponse() in lib/ai/predict.ts will route
# requests to Gemini instead of the local rule-based knowledge base.
GEMINI_API_KEY=AIzaSyDVeEn_Ch5kF36VgMDP76exVwp8GaVe3gY

# (Alternative) OpenAI API key — pick one provider.
OPENAI_API_KEY=

# ---- GOOGLE MAPS ----
# Public API key used by the Clinic Finder feature.
# Replace this with a real Google Maps JavaScript API key from the
# Google Cloud Console.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# ---- DEPLOYMENT ----
# Base URL of the deployed app (used for absolute links).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Node environment (development | production)
NODE_ENV=development
